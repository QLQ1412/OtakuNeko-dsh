{
  "name": "otakuneko-harness-native-plugin",
  "version": "0.2.0-alpha.23",
  "private": true,
  "description": "Native OtakuNeko capabilities for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js"
  },
  "scripts": {
    "build:host": "tsdown --config-loader native --config tsdown.host.config.ts",
    "build:client": "tsdown --config-loader native --config tsdown.config.ts",
    "build": "corepack pnpm build:host && corepack pnpm build:client",
    "test": "corepack pnpm build && node --test test/*.test.mjs",
    "pack:plugin": "corepack pnpm build && corepack pnpm pack --pack-destination dist"
  },
  "files": [
    "lib/",
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "UNDICI-LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.0",
    "tsdown": "^0.22.2",
    "undici": "7.30.1"
  }
}
